# Copy this file to backend/.env and fill in the values.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Image editing model. Options: gemini-2.5-flash-image (Nano Banana), gemini-3-pro-image-preview (Nano Banana Pro)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Which image editor to use: "gemini" (real) or "fake" (tints the crop; no API calls, for offline dev/tests)
EDITOR=gemini

# How the editable region is communicated to Gemini: "mask" (polygon mask sent as a second image) or "text"
REGION_HINT=mask

# Secret used to sign login tokens. Any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Where images and the SQLite DB are stored (relative to backend/)
DATA_DIR=./data

# Keyword -> extra Gemini instruction mapping (JSON). Relative paths are resolved from backend/.
PROMPT_HINTS_FILE=prompt_hints.json

# Comprehensive plans: a folder per municipality (e.g. Philadelphia-PA) holding PDF/TXT/MD documents.
# A municipality-specific hints JSON is generated from them (RAG) the first time someone edits there,
# into DATA_DIR/plan_hints/<Municipality>.json, and replaces PROMPT_HINTS_FILE for that city.
PLANS_DIR=../references
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Overpass API mirrors for smart select, comma-separated, tried in order (first is fastest from the US east coast).
# Queries are gated to two at a time and retried on 429/503; processed cells are cached in SQLite for 24 h.
OVERPASS_URLS=https://overpass.openstreetmap.fr/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
OVERPASS_TIMEOUT_S=15

# Guardrails
MAX_BBOX_KM2=1.0
MIN_POLY_M2=20
GENERATIONS_PER_10_MIN=5

# Comma-separated allowed browser origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
