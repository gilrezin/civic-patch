# Copy this file to backend/.env and fill in the values.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Image editing model. Options: gemini-2.5-flash-image (Nano Banana), gemini-3-pro-image-preview (Nano Banana Pro)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Which image editor to use: "gemini" (real) or "fake" (tints the crop; no API calls, for offline dev/tests)
EDITOR=gemini

# How the editable region is communicated to Gemini: "mask" (polygon mask sent as a second image) or "text"
REGION_HINT=mask

# Secret used to sign login tokens. Any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Where images and the SQLite DB are stored (relative to backend/)
DATA_DIR=./data

# Keyword -> extra Gemini instruction mapping (JSON). Relative paths are resolved from backend/.
PROMPT_HINTS_FILE=prompt_hints.json

# Guardrails
MAX_BBOX_KM2=1.0
MIN_POLY_M2=20
GENERATIONS_PER_10_MIN=5

# Comma-separated allowed browser origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
